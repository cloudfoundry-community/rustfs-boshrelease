<%
  port         = p('rustfs.port')
  console_port = p('rustfs.console_port')
  store_path   = p('rustfs.persistent_disk_path')
  vols         = p('rustfs.volumes_per_node').to_i

  tls_enabled = p('rustfs.tls.certificate', '').to_s.strip != '' &&
                p('rustfs.tls.key', '').to_s.strip != ''
  scheme      = tls_enabled ? 'https' : 'http'

  peer_instances = link('rustfs-peer').instances
  url_host  = lambda { |a| a.to_s.include?(':') && !a.to_s.start_with?('[') ? "[#{a}]" : a.to_s }
  ipv6      = peer_instances.any? { |i| i.address.to_s.include?(':') } ||
              spec.address.to_s.include?(':')
  bind_host = ipv6 ? '[::]' : '0.0.0.0'
  if peer_instances.length > 1
    if vols == 1
      volumes_value = peer_instances.map { |i|
        "#{scheme}://#{url_host.call(i.address)}:#{port}#{store_path}/data0"
      }.join(' ')
    else
      volumes_value = peer_instances.map { |i|
        "#{scheme}://#{url_host.call(i.address)}:#{port}#{store_path}/data{0...#{vols - 1}}"
      }.join(' ')
    end
  else
    volumes_value = vols == 1 ? "#{store_path}/data0" : "#{store_path}/data{0...#{vols - 1}}"
  end
-%>
# Sourceable env for ad-hoc shell debugging on the VM.
# Usage: source /var/vcap/jobs/rustfs-server/config/env.sh
# WARNING: contains plaintext credentials — restrict file access.

export RUSTFS_ACCESS_KEY="<%= p('rustfs.access_key') %>"
export RUSTFS_SECRET_KEY="<%= p('rustfs.secret_key') %>"

export RUSTFS_ADDRESS="<%= bind_host %>:<%= port %>"
export RUSTFS_CONSOLE_ADDRESS="<%= bind_host %>:<%= console_port %>"
export RUSTFS_CONSOLE_ENABLE="<%= p('rustfs.console_enable') %>"

export RUSTFS_REGION="<%= p('rustfs.region') %>"

export RUSTFS_VOLUMES="<%= volumes_value %>"

export RUSTFS_OBS_LOGGER_LEVEL="<%= p('rustfs.log_level') %>"
export RUSTFS_HEALTH_ENDPOINT_ENABLE="<%= p('rustfs.health_enable') %>"
<% if p('rustfs.unsafe_bypass_disk_check') -%>
export RUSTFS_UNSAFE_BYPASS_DISK_CHECK="true"
<% end -%>

<% if tls_enabled -%>
export RUSTFS_TLS_PATH="/var/vcap/data/rustfs-server/tls"
<% end -%>

export RUSTFS_PORT="<%= port %>"
export RUSTFS_CONSOLE_PORT="<%= console_port %>"
export RUSTFS_DATA_DIR="<%= store_path %>"
