<%
  # Collect peer instances from BOSH link (includes self).
  peer_instances = link('rustfs-peer').instances
  port           = p('rustfs.port')
  store_path     = p('rustfs.persistent_disk_path')
  vols_per_node  = p('rustfs.volumes_per_node').to_i

  # The API listener serves TLS when both halves of the key pair are set.
  # RustFS serves internode RPC on the same port, so peers must dial it
  # with https, or every TLS handshake fails and the cluster never forms.
  tls_cert_set = p('rustfs.tls.certificate', '').to_s.strip != ''
  tls_key_set  = p('rustfs.tls.key', '').to_s.strip != ''
  if tls_cert_set != tls_key_set
    missing = tls_cert_set ? 'rustfs.tls.key' : 'rustfs.tls.certificate'
    present = tls_cert_set ? 'rustfs.tls.certificate' : 'rustfs.tls.key'
    raise "#{present} is set but #{missing} is not. Set both halves of the key pair for TLS, or neither for plaintext HTTP."
  end
  tls_enabled = tls_cert_set && tls_key_set
  scheme      = tls_enabled ? 'https' : 'http'

  if tls_enabled && peer_instances.length > 1 &&
     !p('rustfs.tls.ca', '').to_s.include?('BEGIN CERTIFICATE')
    raise "rustfs.tls.ca must hold the CA certificate that signed rustfs.tls.certificate, because cluster peers verify each other's API certificates against it."
  end

  # Bracket IPv6 literals so that they can sit inside a URL, and listen on
  # the IPv6 wildcard when any peer address is IPv6.
  url_host  = lambda { |a| a.to_s.include?(':') && !a.to_s.start_with?('[') ? "[#{a}]" : a.to_s }
  ipv6      = peer_instances.any? { |i| i.address.to_s.include?(':') } ||
              spec.address.to_s.include?(':')
  bind_host = ipv6 ? '[::]' : '0.0.0.0'

  # Build RUSTFS_VOLUMES value.
  # Cluster mode (>1 instance): space-separated per-peer URLs.
  # RustFS brace expansion: {0...N-1} is inclusive upper-bound notation.
  # Single-node: local path with brace expansion or bare path.
  if peer_instances.length > 1
    # Distributed mode.  The node count is fixed when the cluster first
    # forms, because RustFS refuses to grow or shrink a pool in place.
    volumes_value = peer_instances.map do |inst|
      if vols_per_node == 1
        "#{scheme}://#{url_host.call(inst.address)}:#{port}#{store_path}/data0"
      else
        "#{scheme}://#{url_host.call(inst.address)}:#{port}#{store_path}/data{0...#{vols_per_node - 1}}"
      end
    end.join(' ')
    cluster_mode = true
  else
    # Single-node mode.
    if vols_per_node == 1
      volumes_value = "#{store_path}/data0"
    else
      volumes_value = "#{store_path}/data{0...#{vols_per_node - 1}}"
    end
    cluster_mode = false
  end
-%>
---
# cluster_mode: <%= cluster_mode %>
processes:
- name: rustfs-server
  executable: /var/vcap/packages/rustfs/bin/rustfs
  args:
  - server
  - "<%= volumes_value %>"

  env:
    # Required credentials
    RUSTFS_ACCESS_KEY: "<%= p('rustfs.access_key') %>"
    RUSTFS_SECRET_KEY: "<%= p('rustfs.secret_key') %>"

    # Network binding
    RUSTFS_ADDRESS:         "<%= bind_host %>:<%= p('rustfs.port') %>"
    RUSTFS_CONSOLE_ADDRESS: "<%= bind_host %>:<%= p('rustfs.console_port') %>"
    RUSTFS_CONSOLE_ENABLE:  "<%= p('rustfs.console_enable') %>"

    # S3 region that requests are signed for and responses report
    RUSTFS_REGION: "<%= p('rustfs.region') %>"

    # Observability
    RUSTFS_OBS_LOGGER_LEVEL: "<%= p('rustfs.log_level') %>"
<% if p('rustfs.obs_log_directory') != '' -%>
    RUSTFS_OBS_LOG_DIRECTORY: "<%= p('rustfs.obs_log_directory') %>"
<% end -%>

    # Health endpoints
    RUSTFS_HEALTH_ENDPOINT_ENABLE: "<%= p('rustfs.health_enable') %>"

<% if p('rustfs.unsafe_bypass_disk_check') -%>
    # Skip distinct-physical-disk validation — local testing/CI only
    RUSTFS_UNSAFE_BYPASS_DISK_CHECK: "true"
<% end -%>

    # Virtual-hosted-style domains
<% if p('rustfs.server_domains') != '' -%>
    RUSTFS_SERVER_DOMAINS: "<%= p('rustfs.server_domains') %>"
<% end -%>

    # Internode cluster tuning
    RUSTFS_INTERNODE_CONNECT_TIMEOUT_SECS:          "<%= p('rustfs.internode.connect_timeout_secs') %>"
    RUSTFS_INTERNODE_TCP_KEEPALIVE_SECS:            "<%= p('rustfs.internode.tcp_keepalive_secs') %>"
    RUSTFS_INTERNODE_HTTP2_KEEPALIVE_INTERVAL_SECS: "5"
    RUSTFS_INTERNODE_RPC_TIMEOUT_SECS:              "<%= p('rustfs.internode.rpc_timeout_secs') %>"

<% if p('rustfs.kms.enable') -%>
    # KMS (server-side encryption)
    RUSTFS_KMS_ENABLE:  "true"
    RUSTFS_KMS_BACKEND: "<%= p('rustfs.kms.backend') %>"
<%   if p('rustfs.kms.vault_address') != '' -%>
    RUSTFS_KMS_VAULT_ADDRESS: "<%= p('rustfs.kms.vault_address') %>"
    RUSTFS_KMS_VAULT_TOKEN:   "<%= p('rustfs.kms.vault_token') %>"
<%   end -%>
<% end -%>

<% if tls_enabled -%>
    # TLS.  pre-start installs rustfs_cert.pem, rustfs_key.pem, and, when
    # rustfs.tls.ca is set, ca.crt into this directory, the names RustFS
    # looks for under RUSTFS_TLS_PATH.  Peers trust ca.crt when they dial
    # each other over https.
    RUSTFS_TLS_PATH: "/var/vcap/data/rustfs-server/tls"
<% end -%>

  limits:
    open_files: <%= p('rustfs.bpm.open_files') %>

  ephemeral_disk: true
  persistent_disk: true

  hooks:
    pre_start: /var/vcap/jobs/rustfs-server/bin/pre-start
