#!/bin/bash
set -eu

PORT=<%= p('rustfs.port') %>
<% tls = p('rustfs.tls.certificate', '').to_s.strip != '' && p('rustfs.tls.key', '').to_s.strip != '' -%>
SCHEME=<%= tls ? 'https' : 'http' %>
<% if tls -%>
# Self-signed/internal CA — skip verification for the loopback probe.
CURL_TLS=(-k)
<% else -%>
CURL_TLS=()
<% end -%>
TIMEOUT=120
elapsed=0

# Wait for the S3 API liveness endpoint to respond.
# RustFS exposes GET /health when RUSTFS_HEALTH_ENDPOINT_ENABLE=true (default).
# The scheme follows the TLS configuration above (https when a cert is set).
while [ "${elapsed}" -lt "${TIMEOUT}" ]; do
  if curl -fsS "${CURL_TLS[@]}" "${SCHEME}://127.0.0.1:${PORT}/health" >/dev/null 2>&1; then
    echo "rustfs-server: healthy after ${elapsed}s"
    exit 0
  fi
  sleep 2
  elapsed=$((elapsed + 2))
done

echo "rustfs-server: did not become healthy within ${TIMEOUT}s" >&2
exit 1
