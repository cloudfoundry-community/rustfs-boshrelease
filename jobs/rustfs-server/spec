---
name: rustfs-server

description: |
  RustFS S3-compatible object storage server. Managed by bpm.
  Cluster peers find each other through the rustfs-peer BOSH link.  The
  node count is fixed at the first deploy, because RustFS cannot grow a
  single node into a cluster or change the size of a formed cluster in
  place.  A cluster needs at least three nodes.

packages:
  - rustfs

templates:
  bin/pre-start.erb:       bin/pre-start
  bin/post-start.erb:      bin/post-start
  bin/s3-read-probe.erb:   bin/s3-read-probe
  bin/drain.erb:           bin/drain
  bin/post-deploy.erb:     bin/post-deploy
  config/bpm.yml.erb:      config/bpm.yml
  config/env.sh.erb:       config/env.sh
  tls/api/rustfs_cert.pem.erb: tls/api/rustfs_cert.pem
  tls/api/rustfs_key.pem.erb:  tls/api/rustfs_key.pem
  tls/ca.crt.erb:              tls/ca.crt
  tls/peer/ca.pem.erb:     tls/peer/ca.pem
  tls/peer/cert.pem.erb:   tls/peer/cert.pem
  tls/peer/key.pem.erb:    tls/peer/key.pem

provides:
  - name: rustfs-peer
    type: rustfs-peer
    properties:
      - rustfs.port

consumes:
  - name: rustfs-peer
    type: rustfs-peer

properties:
  rustfs.access_key:
    description: |
      Admin access key (S3 root credential, maps to RUSTFS_ACCESS_KEY).
      Minimum 3 characters. Required. No default — use CredHub interpolation
      or an explicit manifest value.
    example: AKIAIOSFODNN7EXAMPLE

  rustfs.secret_key:
    description: |
      Admin secret key (S3 root credential, maps to RUSTFS_SECRET_KEY).
      Minimum 8 characters. Required. No default — use CredHub interpolation
      or an explicit manifest value.

  rustfs.region:
    description: S3 region label returned in API responses.
    default: us-east-1

  rustfs.log_level:
    description: "Log level for RUSTFS_OBS_LOGGER_LEVEL. Values: trace, debug, info, warn, error."
    default: info

  rustfs.obs_log_directory:
    description: |
      Directory for log file output (RUSTFS_OBS_LOG_DIRECTORY).
      Empty string routes logs to stdout, which bpm captures to
      /var/vcap/sys/log/rustfs-server/.
    default: ""

  rustfs.port:
    description: |
      TCP port for the S3 API, admin interface, and internode gRPC
      (RUSTFS_ADDRESS). All cluster peers must use the same port.
    default: 9000

  rustfs.console_port:
    description: TCP port for the web console (RUSTFS_CONSOLE_ADDRESS).
    default: 9001

  rustfs.console_enable:
    description: Enable the web console (RUSTFS_CONSOLE_ENABLE).
    default: true

  rustfs.persistent_disk_path:
    description: |
      Base directory for data volumes on the persistent disk.
      Sub-directories data0..dataN-1 are created here by pre-start.
    default: /var/vcap/store/rustfs-server

  rustfs.volumes_per_node:
    description: |
      Number of data sub-directories per node (e.g., data0, data1, ...).
      Combined with the peer count from the rustfs-peer link to build
      RUSTFS_VOLUMES. Keep at 1 on BOSH: RustFS requires each local data
      volume to live on a distinct physical disk, and a BOSH instance has
      a single persistent disk. Erasure coding spans nodes instead, so use
      three or more instances. Values above 1 fail RustFS disk validation at
      startup unless unsafe_bypass_disk_check is enabled.
    default: 1

  rustfs.unsafe_bypass_disk_check:
    description: |
      Set RUSTFS_UNSAFE_BYPASS_DISK_CHECK=true to skip the distinct-
      physical-disk validation for local erasure endpoints. Only for
      local testing or CI — never production. Required if
      volumes_per_node is greater than 1 on a single persistent disk.
    default: false

  rustfs.server_domains:
    description: |
      Comma-separated virtual-hosted-style domain list
      (RUSTFS_SERVER_DOMAINS). Leave empty to disable.
    default: ""

  rustfs.health_enable:
    description: |
      Enable /health and /health/ready endpoints
      (RUSTFS_HEALTH_ENDPOINT_ENABLE).
    default: true

  rustfs.internode.connect_timeout_secs:
    description: |
      Internode connect timeout in seconds
      (RUSTFS_INTERNODE_CONNECT_TIMEOUT_SECS).
    default: 3

  rustfs.internode.tcp_keepalive_secs:
    description: |
      Internode TCP keepalive in seconds
      (RUSTFS_INTERNODE_TCP_KEEPALIVE_SECS).
    default: 10

  rustfs.internode.rpc_timeout_secs:
    description: |
      Internode RPC timeout in seconds
      (RUSTFS_INTERNODE_RPC_TIMEOUT_SECS).
    default: 10

  rustfs.tls.certificate:
    description: |
      PEM-encoded TLS certificate for the S3 API endpoint. Rendered to
      tls/api/rustfs_cert.pem, which pre-start installs into the TLS
      directory that RUSTFS_TLS_PATH names. Set it together with
      rustfs.tls.key, or omit both for plaintext HTTP.  Template rendering
      fails when only one of the two is set, rather than falling back to
      plaintext.

  rustfs.tls.key:
    description: |
      PEM-encoded TLS private key for the S3 API endpoint. Rendered to
      tls/api/rustfs_key.pem, which pre-start installs into the TLS
      directory that RUSTFS_TLS_PATH names. Set it together with
      rustfs.tls.certificate, or omit both for plaintext HTTP.  Template
      rendering fails when only one of the two is set.

  rustfs.tls.ca:
    description: |
      PEM-encoded CA certificate that signed rustfs.tls.certificate. When it
      is set, pre-start installs it as ca.crt next to the API key pair, and
      RustFS trusts it when cluster peers dial each other over https.  The
      post-start and drain scripts verify every node against it too.  A TLS
      cluster needs it, and every peer's API certificate must name that
      peer's link address, so template rendering fails for a TLS cluster
      without it.  On a single node the post-start check dials 127.0.0.1,
      so the certificate must name 127.0.0.1 when this CA is set.  Without
      it, a single TLS node is probed without verification.
    default: ""

  rustfs.peer.tls.ca:
    description: |
      Rendered to tls/peer/ca.pem.
      RustFS does not read this file. Peers reach each other over the S3
      API port and its rustfs.tls.* certificate, so peer trust comes from
      rustfs.tls.ca. The property is kept so that existing manifests that
      set it still deploy.

  rustfs.peer.tls.certificate:
    description: |
      Rendered to tls/peer/cert.pem.
      RustFS does not read this file. Peers reach each other over the S3
      API port and its rustfs.tls.* certificate, so peer trust comes from
      rustfs.tls.ca. The property is kept so that existing manifests that
      set it still deploy.

  rustfs.peer.tls.key:
    description: |
      Rendered to tls/peer/key.pem.
      RustFS does not read this file. Peers reach each other over the S3
      API port and its rustfs.tls.* certificate, so peer trust comes from
      rustfs.tls.ca. The property is kept so that existing manifests that
      set it still deploy.

  rustfs.kms.enable:
    description: |
      Enable server-side encryption via KMS integration
      (RUSTFS_KMS_ENABLE).
    default: false

  rustfs.kms.backend:
    description: |
      KMS backend to use when kms.enable is true
      (RUSTFS_KMS_BACKEND). Values: local, vault, vault-kv2, vault-transit.
    default: local

  rustfs.kms.vault_address:
    description: |
      Vault server address for KMS (RUSTFS_KMS_VAULT_ADDRESS).
      Required when kms.backend is vault, vault-kv2, or vault-transit.
    default: ""

  rustfs.kms.vault_token:
    description: |
      Vault token for KMS authentication (RUSTFS_KMS_VAULT_TOKEN).
      Required when kms.backend is vault, vault-kv2, or vault-transit.
    default: ""

  rustfs.post_start.health_timeout_secs:
    description: |
      How long post-start waits for this node's /health endpoint to answer
      before it fails the start.
    default: 120

  rustfs.post_start.ready_timeout_secs:
    description: |
      How long post-start waits for this node to serve reads once it has
      found another peer that is already ready, which means the cluster is
      formed and this node should rejoin it.  Serving means that this node
      and every other live peer answer /health/ready, that none of them
      lists an unavailable drive, and that an authenticated S3 read through
      this node succeeds.  A single node waits for its own readiness and
      the read.  When no other peer is ready, as on a fresh deploy or a
      cold start after a full outage, post-start does not wait at all,
      because a new cluster is not ready until enough nodes are up.  When
      reads succeed but a drive is still unavailable at the end of this
      time, post-start logs a warning and passes, because a drive that
      stays down that long needs an operator rather than a longer wait.
    default: 300

  rustfs.post_start.settle_checks:
    description: |
      How many checks in a row, two seconds apart, must find the node
      serving before post-start passes.  RustFS caches its readiness
      answer for about a second, so more than one check keeps a single
      early answer from letting BOSH move on to the next node.
    default: 3

  rustfs.drain.timeout_secs:
    description: |
      Total time the drain script waits for every other peer to answer
      /health/ready and to see every drive before it lets BOSH stop this
      node.  Once it passes, drain logs that it gave up and lets the stop
      go ahead, so that `bosh stop` and `bosh delete-deployment` of a whole
      cluster still finish.  A single node never waits.
    default: 600

  rustfs.drain.poll_secs:
    description: |
      Seconds between drain checks.  Drain returns this as a negative
      number, which makes BOSH call it again after that many seconds.
    default: 5

  rustfs.bpm.open_files:
    description: BPM open_files ulimit for the rustfs-server process.
    default: 65536
