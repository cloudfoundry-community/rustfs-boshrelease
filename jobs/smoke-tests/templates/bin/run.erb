#!/usr/bin/env bash
# RustFS smoke-test errand.
# Tests: /health/ready probe on every peer + S3 CreateBucket/PutObject/GetObject/
#        DeleteObject/HeadObject(404)/DeleteBucket cycle against primary peer.
# Auth:  AWS Signature Version 4 via openssl + curl (no extra packages needed).
# Usage: bosh -d <deployment> run-errand smoke-tests
set -e -u -o pipefail

<%
  peers   = link('rustfs-peer').instances
  port    = p('rustfs.port')
  timeout = p('smoke_tests.timeout_secs')

  # Bracket IPv6 literals so that they can sit inside a URL and a Host header.
  url_host = lambda { |a| a.to_s.include?(':') && !a.to_s.start_with?('[') ? "[#{a}]" : a.to_s }

  tls    = p('rustfs.tls.certificate', '').to_s.strip != ''
  ca_set = p('rustfs.tls.ca', '').to_s.include?('BEGIN CERTIFICATE')
-%>

ACCESS_KEY="<%= p('rustfs.access_key') %>"
SECRET_KEY="<%= p('rustfs.secret_key') %>"
PORT=<%= port %>
REGION="<%= p('rustfs.region') %>"
TIMEOUT=<%= timeout %>

# The scheme follows the API TLS configuration.  With a CA, every node is
# verified against it by its link address, which the API certificate names.
SCHEME="<%= tls ? 'https' : 'http' %>"
<% if tls && ca_set -%>
CURL_TLS=(--cacert /var/vcap/jobs/smoke-tests/tls/ca.crt)
<% elsif tls -%>
echo "SMOKE WARN: rustfs.tls.ca is unset, so certificates are not verified" >&2
CURL_TLS=(-k)
<% else -%>
CURL_TLS=()
<% end -%>

# Peer list from BOSH link (includes primary).
PEERS=(
<% peers.each do |inst| -%>
  "<%= url_host.call(inst.address) %>"
<% end -%>
)

PRIMARY="${PEERS[0]}"
HOST_HDR="${PRIMARY}:${PORT}"
ENDPOINT="${SCHEME}://${HOST_HDR}"

# Unique bucket name scoped to this errand run so parallel runs don't clash.
BUCKET="smoke-$(date +%s)-$$"
KEY="smoke-test.txt"
PAYLOAD="rustfs smoke test payload $(date -u +%FT%TZ)"

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

fail() {
  echo "SMOKE FAIL: $*" >&2
  exit 1
}

ok() {
  echo "SMOKE OK:   $*"
}

# sha256_hex <data> — lowercase hex SHA-256 of the argument.
sha256_hex() {
  printf '%s' "$1" | openssl dgst -sha256 | awk '{print $NF}'
}

# to_hex: lowercase hex of stdin.  -v keeps od from folding repeated lines
# into a '*', which would corrupt any value with a repeated 16-byte run.
to_hex() {
  od -An -v -tx1 | tr -d ' \n'
}

# hex_to_esc <hex>: the same bytes as printf %b escapes.
hex_to_esc() {
  local hex="$1" out="" i
  for ((i = 0; i < ${#hex}; i += 2)); do
    out+="\\x${hex:i:2}"
  done
  printf '%s' "${out}"
}

# hmac_hex <key-hex> <data>: lowercase hex HMAC-SHA256, per RFC 2104.
# The key never reaches a command line.  printf is a shell builtin, and
# openssl only hashes what arrives on stdin, so neither the secret key nor
# a derived signing key shows up in ps output.
hmac_hex() {
  local key_hex="$1" data="$2" ipad="" opad="" i b
  if (( ${#key_hex} > 128 )); then
    key_hex="$(printf '%b' "$(hex_to_esc "${key_hex}")" | openssl dgst -sha256 -binary | to_hex)"
  fi
  while (( ${#key_hex} < 128 )); do
    key_hex+="00"
  done
  for ((i = 0; i < 128; i += 2)); do
    b=$((16#${key_hex:i:2}))
    printf -v ipad '%s\\x%02x' "${ipad}" $((b ^ 0x36))
    printf -v opad '%s\\x%02x' "${opad}" $((b ^ 0x5c))
  done
  local inner
  inner="$({ printf '%b' "${ipad}"; printf '%b' "${data}"; } | openssl dgst -sha256 -binary | to_hex)"
  { printf '%b' "${opad}"; printf '%b' "$(hex_to_esc "${inner}")"; } | openssl dgst -sha256 -binary | to_hex
}

# sigv4 <METHOD> <canonical-path> <payload-hash>
# Populates the global SIG_HEADERS array with the signed request headers.
# Signs the minimal header set (host, x-amz-content-sha256, x-amz-date); no
# Content-Type is sent, so every request type shares one signing path.
SIG_HEADERS=()
sigv4() {
  local method="$1" path="$2" phash="$3"
  local amzdate datestamp
  amzdate="$(date -u +%Y%m%dT%H%M%SZ)"
  datestamp="$(date -u +%Y%m%d)"

  local signed_headers canon_headers canon_req cr_hash scope sts
  signed_headers="host;x-amz-content-sha256;x-amz-date"
  canon_headers="host:${HOST_HDR}\nx-amz-content-sha256:${phash}\nx-amz-date:${amzdate}\n"
  canon_req="${method}\n${path}\n\n${canon_headers}\n${signed_headers}\n${phash}"
  cr_hash="$(printf '%b' "$canon_req" | openssl dgst -sha256 | awk '{print $NF}')"

  scope="${datestamp}/${REGION}/s3/aws4_request"
  sts="AWS4-HMAC-SHA256\n${amzdate}\n${scope}\n${cr_hash}"

  local k_date k_region k_svc k_sign sig
  local k_secret
  k_secret="$(printf '%s' "AWS4${SECRET_KEY}" | to_hex)"
  k_date="$(hmac_hex "${k_secret}" "${datestamp}")"
  k_region="$(hmac_hex "${k_date}" "${REGION}")"
  k_svc="$(hmac_hex "${k_region}" "s3")"
  k_sign="$(hmac_hex "${k_svc}" "aws4_request")"
  sig="$(hmac_hex "${k_sign}" "${sts}")"

  SIG_HEADERS=(
    -H "Host: ${HOST_HDR}"
    -H "x-amz-date: ${amzdate}"
    -H "x-amz-content-sha256: ${phash}"
    -H "Authorization: AWS4-HMAC-SHA256 Credential=${ACCESS_KEY}/${scope}, SignedHeaders=${signed_headers}, Signature=${sig}"
  )
}

# s3_request <METHOD> <path> [body-data]
# Signs and issues the request; fails on HTTP error. Echoes the response body.
s3_request() {
  local method="$1"
  local path="$2"
  local body="${3:-}"

  local phash
  phash="$(sha256_hex "${body}")"
  sigv4 "${method}" "${path}" "${phash}"

  local curl_args=(
    -fsS -g
    ${CURL_TLS[@]+"${CURL_TLS[@]}"}
    --max-time "${TIMEOUT}"
    -X "${method}"
    "${SIG_HEADERS[@]}"
  )
  if [[ -n "${body}" ]]; then
    curl_args+=(--data-binary "${body}")
  fi

  curl "${curl_args[@]}" "${ENDPOINT}${path}"
}

# s3_head_status <path>
# Returns the HTTP status code for a HEAD request (does not fail on 4xx).
# --head makes curl skip the response body.  With -X HEAD over plaintext
# HTTP/1.1, curl waits for the body that the 404 advertises in
# Content-Length and fails with a timeout.
s3_head_status() {
  local path="$1"
  local phash
  phash="$(sha256_hex "")"
  sigv4 HEAD "${path}" "${phash}"

  curl -sS -g ${CURL_TLS[@]+"${CURL_TLS[@]}"} --max-time "${TIMEOUT}" \
    -o /dev/null \
    -w '%{http_code}' \
    --head \
    "${SIG_HEADERS[@]}" \
    "${ENDPOINT}${path}"
}

# ---------------------------------------------------------------------------
# Phase 1: /health/ready probe on every peer
# ---------------------------------------------------------------------------
# /health only says a process is up.  /health/ready says the node is part of
# a formed erasure set and can serve data, which is what a smoke test needs.
echo "=== Phase 1: Cluster readiness probe (${#PEERS[@]} peer(s)) ==="
for peer in "${PEERS[@]}"; do
  rc=0
  curl -fsS -g ${CURL_TLS[@]+"${CURL_TLS[@]}"} --max-time "${TIMEOUT}" -o /dev/null \
    "${SCHEME}://${peer}:${PORT}/health/ready" 2>/dev/null || rc=$?
  case "${rc}" in
    0)        ok "ready ${peer}:${PORT}" ;;
    51|60|77) fail "the certificate at ${peer}:${PORT} did not verify against the CA (curl exit ${rc})" ;;
    *)        fail "readiness probe failed: ${SCHEME}://${peer}:${PORT}/health/ready did not return 2xx within ${TIMEOUT}s (curl exit ${rc})" ;;
  esac
done

echo ""

# ---------------------------------------------------------------------------
# Phase 2: S3 API round-trip (CreateBucket → Put → Get → Delete → Head → DeleteBucket)
# ---------------------------------------------------------------------------
echo "=== Phase 2: S3 round-trip (endpoint=${ENDPOINT}, bucket=${BUCKET}) ==="

# CreateBucket
s3_request PUT "/${BUCKET}" "" \
  || fail "CreateBucket /${BUCKET} — HTTP error"
ok "CreateBucket ${BUCKET}"

# PutObject
s3_request PUT "/${BUCKET}/${KEY}" "${PAYLOAD}" \
  || fail "PutObject /${BUCKET}/${KEY} — HTTP error"
ok "PutObject ${KEY}"

# GetObject and verify content
got="$(s3_request GET "/${BUCKET}/${KEY}" "" \
  || fail "GetObject /${BUCKET}/${KEY} — HTTP error")"

if [[ "${got}" != "${PAYLOAD}" ]]; then
  fail "GetObject content mismatch — expected: '${PAYLOAD}', got: '${got}'"
fi
ok "GetObject content verified"

# DeleteObject
s3_request DELETE "/${BUCKET}/${KEY}" "" \
  || fail "DeleteObject /${BUCKET}/${KEY} — HTTP error"
ok "DeleteObject ${KEY}"

# HeadObject — must return 404 to confirm deletion
http_code="$(s3_head_status "/${BUCKET}/${KEY}")"
if [[ "${http_code}" != "404" ]]; then
  fail "HeadObject after delete returned HTTP ${http_code} — object still present"
fi
ok "HeadObject returned 404 — deletion confirmed"

# DeleteBucket (best-effort cleanup; do not fail errand if this errors)
s3_request DELETE "/${BUCKET}" "" >/dev/null 2>&1 || true
ok "DeleteBucket ${BUCKET} (cleanup)"

echo ""
echo "=== ALL SMOKE CHECKS PASSED ==="
exit 0
