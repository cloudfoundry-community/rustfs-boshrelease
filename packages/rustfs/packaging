#!/bin/bash
set -eu

# The upstream archive is a zip, so the compile VM needs unzip.  Both the
# ubuntu-noble and ubuntu-resolute stemcells install it.
if ! command -v unzip >/dev/null 2>&1; then
  echo "unzip not found in PATH; it is required to extract the rustfs archive" >&2
  exit 1
fi

# The spec glob matches exactly one archive.  Refuse to guess when the blob
# set holds none or several, because the wrong one would ship silently.
shopt -s nullglob
archives=(rustfs/rustfs-linux-x86_64-musl-*.zip)
shopt -u nullglob
if [ "${#archives[@]}" -eq 0 ]; then
  echo "rustfs zip archive not found; check that the blob key matches the spec glob" >&2
  exit 1
fi
if [ "${#archives[@]}" -gt 1 ]; then
  echo "more than one rustfs zip archive found, remove all but one blob: ${archives[*]}" >&2
  exit 1
fi
archive="${archives[0]}"

# Extract inside the compile directory rather than /tmp, so that the
# archive's contents never land in a directory shared with other packages.
extract_dir="${PWD}/rustfs-extract"
rm -rf "${extract_dir}"
mkdir -p "${extract_dir}"

echo "Extracting ${archive}..."
unzip -q -o "${archive}" -d "${extract_dir}"

# Upstream ships the binary at the top of the archive.  Search the tree so
# that a versioned sub-directory in a later archive still works, but refuse
# an archive that holds more than one rustfs file.
mapfile -t binaries < <(find "${extract_dir}" -type f -name rustfs)
if [ "${#binaries[@]}" -ne 1 ]; then
  echo "expected exactly one rustfs binary inside ${archive}, found ${#binaries[@]}; archive contents:" >&2
  find "${extract_dir}" -maxdepth 3 -type f >&2
  exit 1
fi

mkdir -p "${BOSH_INSTALL_TARGET}/bin"
install -m 0755 "${binaries[0]}" "${BOSH_INSTALL_TARGET}/bin/rustfs"
rm -rf "${extract_dir}"

# A binary that cannot report its version will not start either, so the
# compile fails here instead of at deploy time.
echo "Installed ${BOSH_INSTALL_TARGET}/bin/rustfs"
"${BOSH_INSTALL_TARGET}/bin/rustfs" --version
